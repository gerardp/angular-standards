/blob-report

# Environment / secrets
# Nothing secret should ever reach the client bundle — see angular-standards/references/security.md#secrets.
# These are ignored so a local .env cannot be committed by accident.
.env
.env.*
!.env.example
*.pem
*.key

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# macOS / Windows / Linux
.DS_Store
Thumbs.db
desktop.ini
*~

# Agent tooling
# Local, machine-specific agent settings. AGENTS.local.md is NOT ignored — it is the
# project's override file and belongs in version control (see AGENTS.md).
.claude/settings.local.json

# Spartan
# Generated Helm source IS committed — it is our code (angular-standards/references/spartan-ui.md).
# Nothing to ignore here; this note exists so nobody adds an ignore for it later.
