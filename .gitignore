# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log
.pnpm-debug.log

# Angular
.angular/cache
/.angular
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# Vitest
/.vitest
/vitest-report

# Playwright
/test-results
/playwright-report
